# Express configuration
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# DigiCha Supabase project. Keep the service-role key server-side only.
DIGICHA_SUPABASE_URL=https://YOUR-DIGICHA-PROJECT-REF.supabase.co
DIGICHA_SUPABASE_ANON_KEY=replace_with_digicha_public_anon_or_publishable_key
DIGICHA_SUPABASE_SERVICE_ROLE_KEY=replace_with_digicha_server_only_service_role_key

# Mochajaki Supabase project. This must be a different project/database from DigiCha.
MOCHAJAKI_SUPABASE_URL=https://YOUR-MOCHAJAKI-PROJECT-REF.supabase.co
MOCHAJAKI_SUPABASE_ANON_KEY=replace_with_mochajaki_public_anon_or_publishable_key
MOCHAJAKI_SUPABASE_SERVICE_ROLE_KEY=replace_with_mochajaki_server_only_service_role_key

# Optional shared Stripe Checkout integration.
# Use a Stripe test-mode secret key while testing. Do not use a live key until launch checks pass.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Development catalog/ordering only. Set to false in production.
ALLOW_SAMPLE_ORDERS=true
