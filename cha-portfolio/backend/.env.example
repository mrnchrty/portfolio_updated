# Express configuration
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings. Use the project's public/anon key only on the server for Auth.
# Keep the service-role key server-side. Never add real values to source control.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=replace_with_your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_server_only_service_role_key

# Optional Stripe Checkout integration.
# Use a Stripe test-mode secret key while testing. Do not use a live key until launch checks pass.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Development catalog/ordering only. Set to false in production.
ALLOW_SAMPLE_ORDERS=true
